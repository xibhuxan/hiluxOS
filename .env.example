# hiluxOS — example environment configuration
# Copy to .env (backend/) and adjust as needed. Never commit real secrets.

# ---- PostgreSQL (Docker) ----
POSTGRES_USER=hiluxos
POSTGRES_PASSWORD=hiluxos_dev
POSTGRES_DB=hiluxos
POSTGRES_PORT=5432

# ---- Backend (NestJS) ----
# Host on which the API listens
PORT=3000
# CORS origin for the Flutter app; "*" in dev, the app origin in prod
CORS_ORIGIN=*
# Prisma connection string. Host "localhost" when running backend on host.
DATABASE_URL=postgresql://hiluxos:hiluxos_dev@localhost:5432/hiluxos?schema=public
# Radio Browser API base URL (backend proxies searches to Flutter)
RADIO_API_URL=https://de1.api.radio-browser.info

# ---- Flutter app ----
# Base URL the app uses to reach the backend
APP_API_URL=http://localhost:3000
APP_WS_URL=ws://localhost:3000/events

# ---- OTA Updates ----
# Root directory for blue-green deployments (default: /opt/hiluxos)
UPDATE_INSTALL_ROOT=/opt/hiluxos
# URL to the VERSION.txt file on master (used to check for updates)
UPDATE_VERSION_URL=https://raw.githubusercontent.com/xibhuxan/hiluxOS/master/VERSION.txt
# URL to download the whole repo as a tarball (master branch)
UPDATE_TARBALL_URL=https://github.com/xibhuxan/hiluxOS/archive/refs/heads/master.tar.gz