// hiluxOS Prisma schema — PostgreSQL
// See ARCHITECTURE.md: only Prisma accesses PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single application setting, keyed by name. Stores JSON-serializable values.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// A radio station cached from the Radio Browser API search results.
model RadioStation {
  id          String   @id @default(uuid())
  name        String
  url         String   @unique
  favicon     String?
  country     String?
  codec       String?
  bitrate     Int?
  tags        String[]
  createdAt   DateTime @default(now())

  favorites Favorite[]
  history   History[]

  @@map("radio_stations")
}

/// A user-favorited radio station.
model Favorite {
  id        String   @id @default(uuid())
  stationId String
  station   RadioStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([stationId])
  @@map("favorites")
}

/// An entry in the playback history (radio + media).
model History {
  id        String   @id @default(uuid())
  stationId String?
  station   RadioStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  trackId   String?
  track     Track?        @relation(fields: [trackId], references: [id], onDelete: SetNull)
  kind      String   @default("radio") // "radio" | "media" | ...
  title     String
  url       String
  playedAt  DateTime @default(now())

  @@index([playedAt])
  @@map("history")
}

/// A local music file indexed by the media library scanner.
model Track {
  id          String    @id @default(uuid())
  /// Absolute filesystem path of the file (unique).
  path        String    @unique
  title       String
  artist      String?
  album       String?
  genre       String?
  /// Duration in seconds, from ffprobe.
  durationSec Float
  trackNo     Int?
  year        Int?
  bitrate     Int?
  codec       String?
  sizeBytes   BigInt
  /// File mtime (ms epoch) at scan time — used for incremental rescans.
  mtimeMs     BigInt
  playCount   Int       @default(0)
  lastPlayedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  history     History[]

  @@index([artist])
  @@index([album])
  @@map("tracks")
}

/// A user-configured library folder, scanned by the media library scanner
/// in addition to (or instead of) the legacy single MEDIA_DIR. Rows whose
/// path no longer exists on disk are kept — the client shows them with a
/// "missing" marker and a rescan simply skips them until they reappear.
model MediaFolder {
  id        String   @id @default(uuid())
  /// Absolute filesystem path (unique, normalized with path.resolve).
  path      String   @unique
  createdAt DateTime @default(now())

  @@map("media_folders")
}

/// Append-only log of backend events (useful for diagnostics).
model EventLog {
  id        BigInt   @id @default(autoincrement())
  event     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@map("event_log")
}

/// A notification pushed by any module via NotificationsService.
/// type: "info" | "success" | "warning" | "error"
/// action: optional JSON with { screen: string, payload?: any } for navigation.
model Notification {
  id        BigInt   @id @default(autoincrement())
  type      String   @default("info")
  title     String
  message   String?
  action    Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
  @@map("notifications")
}

/// Append-only log of OTA update attempts (check / download / apply / rollback).
/// status: "idle" | "checking" | "downloading" | "verifying" | "applying" | "restarting" | "done" | "failed" | "rolled_back"
model UpdateLog {
  id           BigInt   @id @default(autoincrement())
  status       String   @default("idle")
  fromVersion  String?
  toVersion    String?
  bundleUrl    String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("update_log")
}

/// A pending action / reminder shown on the home "Pendientes" card.
/// kind: "date" | "km" | "version" | "none". value holds the human detail.
model Task {
  id        String   @id @default(uuid())
  title     String
  kind      String   @default("none")
  value     String?
  done      Boolean  @default(false)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}