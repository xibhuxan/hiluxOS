# Copy to .env for local development. All values must come from env vars
# (ARCHITECTURE.md: "All configuration must come from environment variables").
PORT=3000
CORS_ORIGIN=*
DATABASE_URL=postgresql://hiluxos:hiluxos_dev@localhost:5432/hiluxos?schema=public
RADIO_API_URL=https://de1.api.radio-browser.info
# HAL driver selection (Fase 3) — substitute the implementation via env vars
# (ARCHITECTURE.md "Implementation substitution"). Defaults: mock.
HAL_VEHICLE=mock
# HAL_VEHICLE=esp32        # centralita paralela ESP32 (ADR-0002, protocol TBD)
ESP32_HOST=
ESP32_PORT=
ESP32_SERIAL_PATH=
HAL_POWER=mock
# HAL_POWER=rpi            # vcgencmd get_throttled (undervoltage/throttle)
HAL_GPIO=mock

# Root folder the media library scanner indexes for music files.
MEDIA_DIR=/home/USER/Music
