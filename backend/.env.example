# Copy to .env for local development. All values must come from env vars
# (ARCHITECTURE.md: "All configuration must come from environment variables").
PORT=3000
CORS_ORIGIN=*
DATABASE_URL=postgresql://hiluxos:hiluxos_dev@localhost:5432/hiluxos?schema=public
RADIO_API_URL=https://de1.api.radio-browser.info
# HAL driver selection (Fase 3) — substitute the implementation via env vars
# (ARCHITECTURE.md "Implementation substitution"). Defaults: mock.
HAL_VEHICLE=mock
# HAL_VEHICLE=esp32        # centralita paralela ESP32 (ADR-0002, protocol TBD)
ESP32_HOST=
ESP32_PORT=
ESP32_SERIAL_PATH=
HAL_POWER=mock
# HAL_POWER=rpi            # vcgencmd get_throttled (undervoltage/throttle)
HAL_GPIO=mock

# Root folder the media library scanner indexes for music files.
MEDIA_DIR=/home/USER/Music

# ---- Asistente de voz ----
# VOICE_DRIVER=mock (por defecto, sin micro) | vosk (Vosk ASR + Piper TTS, en la Pi)
VOICE_DRIVER=mock
# Cerebro LLM del asistente (Ollama local). Cuando el parser regex no entiende
# una frase, el texto va al modelo con tool-calling sobre todos los módulos.
# OLLAMA_URL apunta al servidor `ollama serve`; OLLAMA_MODEL debe estar pulled.
# Para Raspberry Pi 5 (8 GB) usa un modelo pequeño: gemma4:e2b-it-qat (~4.3 GB)
# o qwen3:4b (~2.5 GB). Si Ollama no corre, el asistente degrada a solo regex.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
