# Make the backlight sysfs node group-writable so non-root users
# (e.g. the hiluxOS backend) can adjust brightness. Matches ANY backlight
# device (intel_backlight on laptops, rpi_backlight on the Pi, ...).
#
# We use RUN+= with explicit chmod/chgrp rather than GROUP=/MODE= because on
# recent systemd-udevd, re-triggering an already-present sysfs node does not
# reliably re-apply the GROUP/MODE keys. The RUN commands always execute.
ACTION=="add", SUBSYSTEM=="backlight", \
  RUN+="/usr/bin/chgrp video /sys/class/backlight/%k/brightness", \
  RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"
